      "id": "18e0a6e2-618a-4a5d-8853-144296cd33b5",
      "name": "Get many events",
      "alwaysOutputData": true,
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "pVZ1BUJjwThkkkb6",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const { date, chat_id } = $('Edit Fields').first().json;\n\n// الحجوزات اللي رجعت من Calendar (لو اليوم فاضي بيرجع item فاضي، فبنفلتره)\nconst booked = $input.all()\n  .map(i => i.json)\n  .filter(e => e.start && e.start.dateTime && e.end && e.end.dateTime)\n  .map(e => ({\n    start: DateTime.fromISO(e.start.dateTime),\n    end: DateTime.fromISO(e.end.dateTime),\n  }));\n\nconst OPEN_HOUR = 9;    // بداية الدوام\nconst CLOSE_HOUR = 15;  // نهاية الدوام\nconst SLOT_MIN = 20;    // مدة الكشف بالدقايق\n\nconst day = DateTime.fromISO(date, { zone: 'Africa/Cairo' });\nconst now = DateTime.now().setZone('Africa/Cairo');\nconst closeTime = day.set({ hour: CLOSE_HOUR, minute: 0, second: 0, millisecond: 0 });\n\nconst slots = [];\nlet start = day.set({ hour: OPEN_HOUR, minute: 0, second: 0, millisecond: 0 });\n\nwhile (start.plus({ minutes: SLOT_MIN }) <= closeTime) {\n  const end = start.plus({ minutes: SLOT_MIN });\n  const isPast = start <= now;\n  const isBusy = booked.some(b => b.start < end && b.end > start);\n\n  if (!isPast && !isBusy) {\n    slots.push({\n      label: start.toFormat('HH:mm'),\n      data: 'slot:' + start.toFormat(\"yyyy-MM-dd'T'HH:mm\"),\n    });\n  }\n  start = end;\n}\n\nconst rows = [];\nfor (let i = 0; i < slots.length; i += 3) {\n  rows.push(slots.slice(i, i + 3).map(s => ({ text: s.label, callback_data: s.data })));\n}\nrows.push([{ text: '🔙 رجوع للأيام', callback_data: 'menu:book' }]);\n\nconst text = slots.length\n  ? `المواعيد المتاحة يوم ${date} 👇`\n  : 'للأسف مفيش مواعيد متاحة في اليوم ده 😔 اختار يوم تاني';\n\nreturn [{ json: { chat_id, date, slots, text, reply_markup: { inline_keyboard: rows } } }];"
      },
