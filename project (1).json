    {
      "parameters": {
        "jsCode": "const msg = $json.message;\nconst text = (msg.text || '').trim();\nconst question = msg.reply_to_message.text;\n\n// تحويل الأرقام العربية (٠-٩) لأرقام إنجليزية\nconst toEn = s => s.replace(/[٠-٩]/g, d => '٠١٢٣٤٥٦٧٨٩'.indexOf(d));\nconst clean = toEn(text);\n\n// الموعد من نص السؤال\nconst m = question.match(/(\\d{4}-\\d{2}-\\d{2}) (\\d{2}:\\d{2})/);\n\n// الاسم والسن: آخر رقم في الرسالة هو السن\nconst p = clean.match(/^(.+?)\\s+(\\d{1,3})$/);\n\nconst age = p ? Number(p[2]) : null;\nconst name = p ? p[1].trim() : null;\nconst words = name ? name.split(/\\s+/).filter(Boolean).length : 0;\nconst valid = !!(m && p && words >= 3 && age >= 1 && age <= 110);\n\nreturn [{\n  json: {\n    chat_id: msg.chat.id,\n    valid,\n    name,\n    age,\n    date: m ? m[1] : null,\n    time: m ? m[2] : null,\n  }\n}];"
      },
