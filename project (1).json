    {
      "parameters": {
        "jsCode": "const names = ['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];\nconst now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Africa/Cairo' }));\nconst days = [];\n\nfor (let i = 0; i < 14 && days.length < 6; i++) {\n  const d = new Date(now);\n  d.setDate(now.getDate() + i);\n  if (d.getDay() === 5 || d.getDay() === 6) continue; // الجمعة والسبت إجازة\n  const y = d.getFullYear();\n  const m = String(d.getMonth() + 1).padStart(2, '0');\n  const day = String(d.getDate()).padStart(2, '0');\n  days.push({ label: `${names[d.getDay()]} ${day}/${m}`, data: `date:${y}-${m}-${day}` });\n}\n\nreturn [{ json: { chat_id: $json.callback_query.message.chat.id, days } }];"
      },
